rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && userDoc().data.role == 'admin' && userDoc().data.isActive == true; }
    function isStudent() { return signedIn() && userDoc().data.role == 'student' && userDoc().data.isActive == true; }
    function myStudentId() { return userDoc().data.studentId; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }
    match /students/{studentId} {
      allow read: if isAdmin() || (isStudent() && resource.data.authUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /tests/{testId} {
      allow read: if isAdmin() || (isStudent() && resource.data.status == 'Published');
      allow create, update, delete: if isAdmin();
    }
    match /results/{resultId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == myStudentId() && resource.data.publicationStatus == 'Published');
      allow create, update, delete: if isAdmin();
    }
    match /attendance/{attendanceId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == myStudentId());
      allow create, update, delete: if isAdmin();
    }
    match /notices/{noticeId} {
      allow read: if isAdmin() || (resource.data.status == 'Published' && resource.data.visibility == 'Students');
      allow create, update, delete: if isAdmin();
    }
    match /publicLeaderboard/{entryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}